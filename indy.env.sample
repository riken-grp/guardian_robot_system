# Indy 環境変数設定サンプル
#
# 使い方:
#   cp indy.env.sample indy.env
#   # indy.env を環境に合わせて編集
#   source indy.env      (~/.bashrc に追記しておくと便利)
#
# ※ APIキー等の秘密情報を含むため、indy.env はリポジトリにコミットしないこと

# ---------------------------------------------------------------
# 必須
# ---------------------------------------------------------------

# ロボット上のソフトウェアの場合、1に設定
# 1 以外（空・未設定含む）の場合、以下のロボット専用パッケージはビルドをスキップする
#   arm_motor_control, arm_moveit_driver, guardian_urdf, ira_laser_tools, urg_node2,
#   vel_filter, rover_wrapper, microphone_array
export ON_ROBOT=

# guardian_robot_systemディレクトリのPATH
export GUARDIAN_ROBOT_PATH=$HOME/xxx/guardian_robot_system

# ロボット名（各launchファイル、bin/ 配下のスクリプト、scenario_launch.sh 等で使用）
export ROBOT_NAME=<robot name>

# MongoDB 接続先（module_launch.sh、scenario_launch.sh、bin/41_say_something.py 等で使用）
export MONGO_URI=<MongoDBのホスト名 or IPアドレス>
export MONGO_PORT=xxxx

### ROS関連設定
# ROS_DOMAIN_ID（1~101、215~232の間の任意の値を設定）
export ROS_DOMAIN_ID=xxx

# DDS設定
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=file://$GUARDIAN_ROBOT_PATH/settings/ros2/zenoh/cyclonedds.xml

# logファイル設定
export ROS_LOG_DIR=/tmp/ros_log


# ---------------------------------------------------------------
# 任意
# ---------------------------------------------------------------

# Slack Webhook URL（レスキューモード通知で使用。空の場合は通知しない）
export SLACK_WEBHOOK_URL=

# OpenAI APIキー（llm_responder, memory で使用）
export OPENAI_API_KEY=

# DeepL APIキー（chat_monitor で使用）
export DEEPL_API_KEY=

# 使用するGPU番号（ssl_server.launch.py で使用。未設定時は 3）
# export CUDA_VISIBLE_DEVICES=3
