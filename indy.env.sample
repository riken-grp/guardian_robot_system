#!/bin/bash
# Indy 環境変数設定サンプル
#
# 使い方:
#   cp <guardian_robot_systemのパス>/indy.env.sample ~/indy.env
#   # ~/indy.env を環境に合わせて編集
#   source ~/indy.env    (~/.bashrc に追記しておく)
#
# ※ APIキー等の秘密情報を含むため、indy.env はリポジトリにコミットしないこと

# ---------------------------------------------------------------
# 必須
# ---------------------------------------------------------------

# ロボット上のソフトウェアの場合、1に設定
# 1 以外（空・未設定含む）の場合、以下のロボット専用パッケージはビルドをスキップする
#   arm_motor_control, arm_moveit_driver, guardian_urdf, ira_laser_tools, urg_node2,
#   vel_filter, rover_wrapper, microphone_array
export ON_ROBOT=

# guardian_robot_systemディレクトリのPATH
export GUARDIAN_ROBOT_PATH=$HOME/xxx/guardian_robot_system

# ロボット名（各launchファイル、tools/bin/ 配下のスクリプト、scenario_launch.sh 等で使用）
export ROBOT_NAME="<robot name>"

# MongoDB 接続先（module_launch.sh、scenario_launch.sh、tools/bin/41_say_something.py 等で使用）
# サーバ側の構築は setup/mongo_docker/README.md を参照．
# MONGO_URI / MONGO_PORT は，サーバの setup/mongo_docker/mongo.env の MONGO_PUBLIC_HOST / MONGO_PORT と同じ値にする．
export MONGO_URI="<MongoDBのホスト名 or IPアドレス>"
export MONGO_PORT=xxxx

### ROS関連設定
# ROS_DOMAIN_ID（1~101、215~232の間の任意の値を設定）
export ROS_DOMAIN_ID=xxx

# DDS設定
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=file://$GUARDIAN_ROBOT_PATH/setup/ros2/zenoh/cyclonedds.xml

# logファイル設定
export ROS_LOG_DIR=/tmp/ros_log

### zenoh ブリッジ（modules/module_launch/available/000_zenoh_bridge.sh で使用）
# 他のマシンとROSで通信するには zenoh ブリッジが必要（CYCLONEDDS_URI の設定でROS通信はマシン内に限定している）。
# 役割: listen=待ち受け側（ロボット側、robodj）、connect=接続側（サーバ側）。domain は ROS_DOMAIN_ID を使う。
# ZENOH_MODE 未設定の場合、ON_ROBOT=1 なら listen、それ以外なら connect として起動する。
# e.g. robodj の場合: export ZENOH_MODE=listen
# export ZENOH_MODE=
# サーバ側: 接続先ロボットのIPアドレス（必須）
export ZENOH_ROBOT_ADDR=
# ロボット側: 待ち受けるIPアドレス（任意。空なら全インタフェースで待ち受け）
export ZENOH_LISTEN=
# ポート番号（任意。ロボット側・サーバ側で同じ値にする。空なら 7447）
export ZENOH_PORT=


# ---------------------------------------------------------------
# 任意
# ---------------------------------------------------------------

# シナリオ対象のロボット名（scenario_launch.sh で使用。空白区切りで複数指定可。未設定の場合は ROBOT_NAME を使用）
# e.g. robodj の場合: export SCENARIO_ROBOTS="dj_ri dj_ken"
# export SCENARIO_ROBOTS=

# Slack Webhook URL（レスキューモード通知で使用。空の場合は通知しない）
export SLACK_WEBHOOK_URL=

# OpenAI APIキー（llm_responder, memory で使用）
export OPENAI_API_KEY=

# DeepL APIキー（chat_monitor で使用）
export DEEPL_API_KEY=

# 使用するGPU番号（サーバ側）
# 音声認識（50_grsrv_asr の asr_launch.py。未設定時は 3）
#   既定値は GPU が4枚以上の構成が前提のため、GPU が4枚未満のマシンでは設定が必要（e.g. GPU が1枚: 0）
# export ASR_GPU_ID=3
# ※画像認識（50_grsrv_recognition）の GPU 番号は GPU の枚数から自動で選ぶため設定不要

# 使用するGPU番号（ssl_server.launch.py で使用。未設定時は 3）
# export CUDA_VISIBLE_DEVICES=3
