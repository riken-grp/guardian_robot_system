<?xml version="1.0" ?>
<robot name="ccn_amr" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Arguments -->
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="robot_name" default="indy" />
  
  <!-- define materials -->
  <material name="yellow">
    <color rgba="0.8 0.8 0.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="purple">
    <color rgba="0.8 0.0 0.8 1.0"/>
  </material>

  <!-- define macros-->
  <xacro:macro name="wheel_macro" params="parent prefix xyz">
    <joint name="${prefix}_joint" type="continuous">
      <origin xyz="${xyz}" rpy="${radians(-90)} 0 0"/>
      <parent link="${parent}"/>
      <child  link="${prefix}_link"/>
      <axis xyz="0 0 1" />
      <limit velocity="300.0" effort="5.0"/> <!-- rad/s, N*m -->
      <dynamics damping="0.1"/>
    </joint>
    <link name="${prefix}_link">
      <visual>
        <geometry>
          <cylinder radius="0.075" length="0.036" />
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.075" length="0.036" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}_link">
      <material>Gazebo/Red</material>
      <mu1 value="1.0" />
      <mu2 value="1.0" />
    </gazebo>
    <transmission name="${prefix}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_motor">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanismReduction>1</mechanismReduction>
      </actuator>
    </transmission>
  </xacro:macro> 

  <!-- robot -->
  <link name="$(arg robot_name)_base_footprint" />

  <joint name="$(arg robot_name)_base_joint" type="fixed">
    <parent link="$(arg robot_name)_base_footprint"/>
    <child link="$(arg robot_name)_base_link"/>
    <origin xyz="0.000 0.000 0.075"/>
  </joint>
  <link name="$(arg robot_name)_base_link">
    <visual>
      <geometry>
        <box size="0.050 0.050 0.050"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>
  <gazebo reference="$(arg robot_name)_base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <xacro:wheel_macro prefix="$(arg robot_name)_left_wheel"  parent="$(arg robot_name)_base_link" xyz="-0.000 0.200 -0.000"/>
  <xacro:wheel_macro prefix="$(arg robot_name)_right_wheel" parent="$(arg robot_name)_base_link" xyz="-0.000 -0.200 -0.000"/>


  <!-- sensors -->
  <joint name="$(arg robot_name)_laser_f_joint" type="fixed">
    <parent link="$(arg robot_name)_base_link"/>
    <child link="$(arg robot_name)_laser_f_link"/>
    <origin xyz="0.165 0.152 0.1273" rpy="0.0 0.0 0.785398" />
  </joint>
  <link name="$(arg robot_name)_laser_f_link">
    <visual>
      <geometry>
        <cylinder radius="0.020" length="0.034" />
      </geometry>
      <material name="purple"/>
    </visual>
  </link>
  <gazebo reference="$(arg robot_name)_laser_f_link">
    <material>Gazebo/Purple</material>
  </gazebo>
  <gazebo reference="$(arg robot_name)_laser_f_link">
    <turnGravityOff>false</turnGravityOff>
    <sensor type="ray" name="$(arg robot_name)_lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>${radians(-135)}</min_angle>
            <max_angle>${radians(135)}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>20.0</max>
          <resolution>0.04</resolution>
        </range>
      </ray>
      <plugin name="$(arg robot_name)_gazebo_lidar_controller"
        filename="libgazebo_ros_laser.so">
        <topicName>$(arg namespace)/scan_l</topicName>
        <frameName>$(arg namespace)/$(arg robot_name)_laser_f_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="$(arg robot_name)_laser_b_joint" type="fixed">
    <parent link="$(arg robot_name)_base_link"/>
    <child link="$(arg robot_name)_laser_b_link"/>
    <origin xyz="-0.165 -0.152 0.1273" rpy="0.0 0.0 -2.356194" />
  </joint>
  <link name="$(arg robot_name)_laser_b_link">
    <visual>
      <geometry>
        <cylinder radius="0.020" length="0.034" />
      </geometry>
      <material name="purple"/>
    </visual>
  </link>
  <gazebo reference="$(arg robot_name)_laser_b_link">
    <material>Gazebo/Purple</material>
  </gazebo>
  <gazebo reference="$(arg robot_name)_laser_b_link">
    <turnGravityOff>false</turnGravityOff>
    <sensor type="ray" name="$(arg robot_name)_lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>${radians(-135)}</min_angle>
            <max_angle>${radians(135)}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>20.0</max>
          <resolution>0.04</resolution>
        </range>
      </ray>
      <plugin name="$(arg robot_name)_gazebo_lidar_controller"
        filename="libgazebo_ros_laser.so">
        <topicName>$(arg namespace)/scan_b</topicName>
        <frameName>$(arg namespace)/$(arg robot_name)_laser_b_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="$(arg robot_name)_camera_bu_joint" type="fixed">
    <parent link="$(arg robot_name)_base_link"/>
    <child link="$(arg robot_name)_camera_bu_link"/>
    <origin xyz="0.21092 0.0 0.02949" rpy="0.0 -1.012291 0.0" />
  </joint>
  <link name="$(arg robot_name)_camera_bu_link">
    <visual>
      <geometry>
        <box size="0.010 0.030 0.020"/>
      </geometry>
      <material name="purple"/>
    </visual>
  </link>
  <gazebo reference="$(arg robot_name)_camera_bu_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <joint name="$(arg robot_name)_camera_td_joint" type="fixed">
    <parent link="$(arg robot_name)_base_link"/>
    <child link="$(arg robot_name)_camera_td_link"/>
    <origin xyz="0.18675 0.0 0.06079" rpy="0.0 0.0 0.0" />
  </joint>
  <link name="$(arg robot_name)_camera_td_link">
    <visual>
      <geometry>
        <box size="0.010 0.030 0.020"/>
      </geometry>
      <material name="purple"/>
    </visual>
  </link>
  <gazebo reference="$(arg robot_name)_camera_td_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <joint name="$(arg robot_name)_body_joint" type="fixed">
    <origin xyz="0 0 0.525" rpy="0 0 0" />
    <parent link="$(arg robot_name)_base_link" />
    <child link="$(arg robot_name)_body_link" />
  </joint>
  <link name="$(arg robot_name)_body_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 1.0" />
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg robot_name)_body_pitch_joint" type="revolute">
    <axis xyz="0 1 0" />
    <limit effort="1000.0" lower="-0.5" upper="1.0" velocity="1.0" />
    <origin xyz="0 0 0.5" rpy="0 0 0" />  <!-- this rotation should be set in neck joint --> 
    <parent link="$(arg robot_name)_body_link" />
    <child link="$(arg robot_name)_neck_link" />
  </joint>
  <link name="$(arg robot_name)_neck_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg robot_name)_neck_yaw_joint" type="revolute">
    <axis xyz="0 0 1" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="1.0" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />  <!-- this rotation should be set in neck joint --> 
    <parent link="$(arg robot_name)_neck_link" />
    <child link="$(arg robot_name)_upper_neck_link" />
  </joint>
  <link name="$(arg robot_name)_upper_neck_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg robot_name)_neck_pitch_joint" type="revolute">
    <axis xyz="0 1 0" />
    <limit effort="1000.0" lower="-1.0" upper="1.0" velocity="1.0" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />  <!-- this rotation should be set in neck joint --> 
    <parent link="$(arg robot_name)_upper_neck_link" />
    <child link="$(arg robot_name)_head_link" />
  </joint>
  <link name="$(arg robot_name)_head_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.15" />
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg robot_name)_camera_joint" type="fixed">
    <origin xyz="0.1 0 0.05" rpy="0 0 0" />
    <parent link="$(arg robot_name)_head_link" />
    <child link="$(arg robot_name)_camera_link" />
  </joint>
  <link name="$(arg robot_name)_camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.15 0.05" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.5 0.5 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg robot_name)_lidar_joint" type="fixed">
    <origin xyz="0.15 0 0" rpy="0 0 0" />
    <parent link="$(arg robot_name)_neck_link" />
    <child link="$(arg robot_name)_lidar_link" />
  </joint>
  <link name="$(arg robot_name)_lidar_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.5 0.5 1.0" />
      </material>
    </visual>
  </link>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>$(arg namespace)</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>
</robot>
