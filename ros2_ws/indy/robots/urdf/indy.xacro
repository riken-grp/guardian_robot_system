<?xml version="1.0"?>
<robot name="indy" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="indy" />
  <xacro:property name="rover_size" value="0.5 0.5 0.3" /> <!-- 適当です -->
  <xacro:property name="body_size" value="0.3 0.3 0.9" /> <!-- 適当です -->
  <xacro:property name="camera_size" value="0.15 0.05 0.05" /> <!-- 適当です -->

  <link name="$(arg robot_name)_base_footprint" />
  <joint name="$(arg robot_name)_base_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <parent link="$(arg robot_name)_base_footprint" />
    <child link="$(arg robot_name)_base_link" />
  </joint>

  <link name="$(arg robot_name)_base_link">
    <visual>
      <geometry>
        <box size="${rover_size}" />
      </geometry>
      <material name="green">
        <color rgba="0.5 1.0 0.5 1.0" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${rover_size}" />
      </geometry>
    </collision>
  </link>

  <joint name="$(arg robot_name)_body_joint" type="fixed">
    <origin xyz="0 0 0.6" rpy="0 0 0" />
    <parent link="$(arg robot_name)_base_link" />
    <child link="$(arg robot_name)_body_link" />
  </joint>

  <link name="$(arg robot_name)_body_link">
    <visual>
      <geometry>
        <box size="${body_size}" />
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${body_size}" />
      </geometry>
    </collision>
  </link>

  <joint name="$(arg robot_name)_camera_joint" type="fixed">
    <origin xyz="0 0 0.45" rpy="0 0.25 0" />  <!-- this rotation should be set in neck joint --> 
    <parent link="$(arg robot_name)_body_link" />
    <child link="$(arg robot_name)_camera_link" />
  </joint>

  <link name="$(arg robot_name)_camera_link">
    <visual>
      <geometry>
        <box size="${camera_size}" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.5 0.5 1.0" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${camera_size}" />
      </geometry>
    </collision>
  </link>
</robot>
