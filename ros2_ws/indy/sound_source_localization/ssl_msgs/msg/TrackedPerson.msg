# A tracked person with position and velocity
int32 person_id      # Unique tracking ID
float32 x            # Position x in meters
float32 y            # Position y in meters
float32 vx           # Velocity x in m/s
float32 vy           # Velocity y in m/s
float32 azimuth      # Azimuth angle from robot in radians
float32 distance     # Distance from robot in meters
