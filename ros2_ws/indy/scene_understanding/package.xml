<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scene_understanding</name>
  <version>0.0.0</version>
  <description>A ROS2 package for scene understanding, including object detection, tracking, and attribute recognition.</description>
  <maintainer email="no-reply@example.com">username</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <depend>recognition_msgs</depend>
  <depend>realsense2_camera</depend>
  <depend>robot_looking</depend>
  <!-- attribute_recognition_node が model_loader を import する -->
  <depend>action_recognition</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
