# FTDI FT232H MPSSE Mode
# Command:
#  sudo cp ./99-ftdi_ft232h_mpsse.rules /etc/udev/rules.d
#  sudo udevadm control --reload

SUBSYSTEM=="usb", ACTION!="remove", ATTRS{idVendor}=="0403",ATTRS{idProduct}=="6014", MODE="0666"
SUBSYSTEM=="usb", DRIVER=="ftdi_sio", ATTRS{idVendor}=="0403",ATTRS{idProduct}=="6014", RUN+="/bin/sh -c 'echo $kernel > /sys/bus/usb/drivers/ftdi_sio/unbind'"