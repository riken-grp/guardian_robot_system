<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="guardian">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import guardian urdf file -->
    <xacro:include filename="$(find guardian_urdf)/urdf/arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="guardian.ros2_control.xacro" />


    <xacro:guardian_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
