# ==============================================================
# MongoDB サーバ用の設定（setup/mongo_docker 専用）
#   cp mongo.env.sample mongo.env して，このマシンに合わせて書き換える（*.env は git 管理外）．
#   docker compose には毎回 --env-file mongo.env を付ける．
#
# ロボット・ROS 側の設定は indy.env（別ファイル）．次の 2 つは indy.env と同じ値にする：
#   MONGO_PUBLIC_HOST = indy.env の MONGO_URI
#   MONGO_PORT        = indy.env の MONGO_PORT
# ==============================================================

# ロボットなど外部のクライアントから名前解決・到達できる，このサーバのホスト名（または IP アドレス）．
# ロボット側 indy.env の MONGO_URI と同じ値にする．
MONGO_PUBLIC_HOST=<server hostname>

# MongoDB のポート．ロボット側 indy.env の MONGO_PORT と同じ値にする．
MONGO_PORT=27017

# mongo-express（Web 管理画面）のポート
ME_PORT=8081

# MongoDB のイメージ．既存データを持ち込む場合は，そのデータと同じメジャーバージョンにする（違うと mongod が起動しない）．
MONGO_IMAGE=mongo:8.0

# データの置き場所（リポジトリの外に置く）．この下に data/ config/ var_cache/ を作る．
MONGO_DATA_DIR=/home/<user>/robots_memory/mongodb

# コンテナ内で mongod を動かす uid / gid．データディレクトリの所有者と合わせる．
MONGO_UID=1001
MONGO_GID=1001

# WiredTiger キャッシュの上限（GB）．未指定時の MongoDB の既定は「(搭載メモリ - 1GB) の 50%」．
# 他の処理（音声認識・LLM など）とメモリを分け合うため控えめにしている．データが大きく遅いときは増やす．
MONGO_CACHE_GB=1

# mongo-express を公開するアドレス．0.0.0.0 で同じネットワーク内の他のマシンのブラウザから開ける．
# mongo-express には認証が無いため，信頼できるネットワーク内でのみ使うこと．
# このマシンからのみに限定するときは 127.0.0.1 にする．
ME_BIND_ADDR=0.0.0.0

# mongo-express のイメージ（通常は変更不要）
#ME_IMAGE=mongo-express:1.0.2
